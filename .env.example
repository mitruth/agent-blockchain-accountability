# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# None of the local test suites need any of this. It is only required to deploy
# to, or read from, Base Sepolia.

ALCHEMY_RPC_URL=https://sepolia.base.org

# --- Three keys. Never collapse two roles onto one key. ---
# Generate with: node scripts/keys/generate_roles.js
#
# The audited version used a single PRIVATE_KEY holding both owner and agent
# authority, which is finding F1 and the reason for the rebuild. There is
# deliberately no single-key variable here.
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=

AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

GUARDIAN_PRIVATE_KEY=
GUARDIAN_ADDRESS=

# --- Deployed addresses, once a deployment exists ---
POLICY_CONFIG_ADDRESS=
SPEND_LEDGER_ADDRESS=
VALIDATOR_ADDRESS=
SMART_ACCOUNT_ADDRESS=

# Optional: a throwaway address to receive test transfers.
# Generate with: node scripts/keys/generate_destination.js
DESTINATION_ADDRESS=
