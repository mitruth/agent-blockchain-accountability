# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# None of the tests or the local demo need any of this: they use Hardhat's
# public test keys. It is only for a deployment to Base Sepolia, which does
# not exist yet.

ALCHEMY_RPC_URL=

# --- Two keys, never one (audit finding F1) ---
# OWNER  the prosumer account's owner: installs the gate, gives the agent its
#        session, configures the policies. Keep it off the agent's machine.
# AGENT  the agent's session key: it can have the account call the gate's
#        submit and nothing else, and it signs nothing for the account.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
